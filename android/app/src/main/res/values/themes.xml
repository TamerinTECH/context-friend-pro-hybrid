<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app draws its own UI in Compose; this theme only sets the window and the Android 12+ splash screen. -->
    <style name="Theme.ContextFriend" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F8FA</item>
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
</resources>
