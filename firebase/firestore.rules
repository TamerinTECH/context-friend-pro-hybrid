rules_version = '2';

// Firestore holds only end-to-end-encrypted cloud links (CloudShare.kt): ciphertext, nonce,
// owner uid and timestamps. No plaintext, no names, no keys. Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    match /shares/{shareId} {
      // Create: a signed-in user, own uid, exactly the expected fields, bounded size, at most 8 days.
      allow create: if request.auth != null
        && shareId.matches('^[A-Za-z0-9_-]{22}$')
        && request.resource.data.keys().hasOnly(['v', 'ct', 'nonce', 'owner', 'createdAt', 'expiresAt'])
        && request.resource.data.v == 1
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.ct is string && request.resource.data.ct.size() < 300000
        && request.resource.data.nonce is string && request.resource.data.nonce.size() == 32
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd');

      // Read one document by its unguessable id while it is valid. Never list the collection.
      allow get: if request.auth != null && resource.data.expiresAt > request.time;
      allow list: if false;

      // The owner can revoke early. Links are never edited.
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
